{
  "name": "codicil-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A developer-controlled, versioned knowledge layer for AI coding agents",
  "packageManager": "pnpm@11.0.9",
  "author": "Pranit Deshmukh",
  "license": "MIT",
  "homepage": "https://github.com/pranit-sh/codicil#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranit-sh/codicil.git"
  },
  "bugs": {
    "url": "https://github.com/pranit-sh/codicil/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/pranit.sh"
  },
  "keywords": [
    "codicil",
    "knowledge",
    "ai",
    "agent",
    "context",
    "mcp",
    "cli",
    "vscode"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && pnpm build && pnpm --filter codicil-vscode test",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
