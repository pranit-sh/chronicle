{
  "name": "codicil-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A developer-controlled, versioned knowledge layer for AI coding agents",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && pnpm build && pnpm --filter codicil-vscode test",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
