{
  "name": "chronicle-vscode",
  "displayName": "Chronicle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "See, review and control the knowledge your AI coding agents work from",
  "publisher": "chronicle",
  "license": "MIT",
  "author": "pranit-sh",
  "homepage": "https://github.com/pranit-sh/chronicle#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/pranit-sh/chronicle.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/pranit-sh/chronicle/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "ai",
    "agents",
    "knowledge",
    "context",
    "mcp",
    "copilot",
    "memory",
    "documentation"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:.chronicle/config.yaml"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node test/smoke.mjs && node test/packaged.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@chronicle/core": "workspace:*",
    "markdown-it": "^15.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^3.9.2"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chronicle",
          "title": "Chronicle",
          "icon": "media/chronicle.svg"
        }
      ]
    },
    "views": {
      "chronicle": [
        {
          "id": "chronicle.gettingStarted",
          "name": "Getting Started",
          "icon": "media/chronicle.svg",
          "when": "!chronicle.initialized"
        },
        {
          "id": "chronicle.knowledge",
          "name": "Knowledge",
          "icon": "media/chronicle.svg",
          "when": "chronicle.initialized"
        },
        {
          "id": "chronicle.proposals",
          "name": "Proposals",
          "icon": "media/chronicle.svg",
          "when": "chronicle.initialized"
        },
        {
          "id": "chronicle.context",
          "name": "Context",
          "icon": "media/chronicle.svg",
          "when": "chronicle.initialized"
        },
        {
          "id": "chronicle.agentSetup",
          "name": "Agent Setup",
          "icon": "media/chronicle.svg",
          "when": "chronicle.initialized"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "chronicle.gettingStarted",
        "contents": "Give your coding agents reliable project knowledge.\n\nChronicle has two parts: this extension for humans, and an MCP server for agents such as Copilot, Cursor and Claude. Initialize the repo first, then connect your agent.\n\n[Initialize Chronicle](command:chronicle.init)\n\n[Agent setup guide](command:chronicle.openMcpSetupGuide)",
        "when": "!chronicle.initialized"
      },
      {
        "view": "chronicle.agentSetup",
        "contents": "Connect your coding agents to Chronicle.\n\nThe extension is the human review UI. Agents read project knowledge through the Chronicle MCP server.\n\n[Open setup guide](command:chronicle.openMcpSetupGuide)",
        "when": "chronicle.initialized"
      },
      {
        "view": "chronicle.knowledge",
        "contents": "No knowledge yet.\n\nKnowledge is the reviewed, project-owned information your agents can use. Remember something to add the first item.",
        "when": "chronicle.initialized && !chronicle.hasKnowledge"
      },
      {
        "view": "chronicle.proposals",
        "contents": "Nothing waiting for review.\n\nProposals are knowledge suggested by agents for your review. Nothing enters the knowledge base until you accept it."
      },
      {
        "view": "chronicle.context",
        "contents": "No context yet.\n\nContext shows which reviewed knowledge applies to the file you have open. Add knowledge to see what agents would be told here.",
        "when": "chronicle.initialized && !chronicle.hasKnowledge"
      },
      {
        "view": "chronicle.context",
        "contents": "No context applies here.\n\nChronicle checked the open file, but no scoped knowledge matched this part of the project.",
        "when": "chronicle.initialized && chronicle.hasKnowledge"
      }
    ],
    "commands": [
      {
        "command": "chronicle.init",
        "title": "Chronicle: Set up the knowledge layer",
        "icon": "$(add)"
      },
      {
        "command": "chronicle.configureMcp",
        "title": "Chronicle: Configure MCP for Copilot",
        "icon": "$(plug)"
      },
      {
        "command": "chronicle.configureCursorMcp",
        "title": "Chronicle: Configure MCP for Cursor",
        "icon": "$(plug)"
      },
      {
        "command": "chronicle.configureClaudeCodeMcp",
        "title": "Chronicle: Configure MCP for Claude Code",
        "icon": "$(plug)"
      },
      {
        "command": "chronicle.addAgentInstructions",
        "title": "Chronicle: Add agent instructions",
        "icon": "$(notebook)"
      },
      {
        "command": "chronicle.openMcpSetupGuide",
        "title": "Chronicle: Open Agent Setup Guide",
        "icon": "$(book)"
      },
      {
        "command": "chronicle.remember",
        "title": "Chronicle: Remember this",
        "icon": "$(lightbulb)"
      },
      {
        "command": "chronicle.rememberSelection",
        "title": "Chronicle: Remember the selected text"
      },
      {
        "command": "chronicle.refresh",
        "title": "Chronicle: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "chronicle.showItem",
        "title": "Chronicle: Show knowledge item"
      },
      {
        "command": "chronicle.openFile",
        "title": "Chronicle: Open the Markdown file",
        "icon": "$(go-to-file)"
      },
      {
        "command": "chronicle.archiveItem",
        "title": "Chronicle: Archive",
        "icon": "$(archive)"
      },
      {
        "command": "chronicle.restoreItem",
        "title": "Chronicle: Restore",
        "icon": "$(history)"
      },
      {
        "command": "chronicle.verifyItem",
        "title": "Chronicle: Verify against the code",
        "icon": "$(check)"
      },
      {
        "command": "chronicle.verifyAll",
        "title": "Chronicle: Verify everything",
        "icon": "$(check-all)"
      },
      {
        "command": "chronicle.reviewProposal",
        "title": "Chronicle: Review proposal"
      },
      {
        "command": "chronicle.acceptProposal",
        "title": "Chronicle: Accept proposal",
        "icon": "$(check)"
      },
      {
        "command": "chronicle.rejectProposal",
        "title": "Chronicle: Reject proposal",
        "icon": "$(close)"
      },
      {
        "command": "chronicle.showContext",
        "title": "Chronicle: What does the agent know here?",
        "icon": "$(eye)"
      },
      {
        "command": "chronicle.doctor",
        "title": "Chronicle: Check the knowledge layer for problems"
      },
      {
        "command": "chronicle.filterByStatus",
        "title": "Chronicle: Filter knowledge",
        "icon": "$(filter)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "chronicle.remember",
          "when": "view == chronicle.knowledge",
          "group": "navigation@1"
        },
        {
          "command": "chronicle.verifyAll",
          "when": "view == chronicle.knowledge",
          "group": "navigation@3"
        },
        {
          "command": "chronicle.refresh",
          "when": "view == chronicle.knowledge || view == chronicle.proposals || view == chronicle.context",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "chronicle.openFile",
          "when": "view == chronicle.knowledge && viewItem =~ /^item/",
          "group": "inline@1"
        },
        {
          "command": "chronicle.verifyItem",
          "when": "view == chronicle.knowledge && viewItem =~ /^item/",
          "group": "1_act@1"
        },
        {
          "command": "chronicle.archiveItem",
          "when": "view == chronicle.knowledge && viewItem == item",
          "group": "1_act@2"
        },
        {
          "command": "chronicle.restoreItem",
          "when": "view == chronicle.knowledge && viewItem == item.archived",
          "group": "1_act@2"
        },
        {
          "command": "chronicle.acceptProposal",
          "when": "view == chronicle.proposals && viewItem == proposal",
          "group": "inline@1"
        },
        {
          "command": "chronicle.rejectProposal",
          "when": "view == chronicle.proposals && viewItem == proposal",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "chronicle.rememberSelection",
          "when": "editorHasSelection",
          "group": "chronicle@1"
        },
        {
          "command": "chronicle.showContext",
          "group": "chronicle@2"
        }
      ],
      "commandPalette": [
        {
          "command": "chronicle.showItem",
          "when": "false"
        },
        {
          "command": "chronicle.openFile",
          "when": "false"
        },
        {
          "command": "chronicle.reviewProposal",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Chronicle",
      "properties": {
        "chronicle.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show how many knowledge items apply to the file you are editing."
        },
        "chronicle.groupBy": {
          "type": "string",
          "enum": [
            "type",
            "status",
            "scope"
          ],
          "default": "type",
          "description": "How to group the knowledge tree."
        }
      }
    }
  }
}
