{
  "name": "codicil-vscode",
  "displayName": "Codicil",
  "version": "0.1.1",
  "type": "module",
  "description": "Project knowledge and context management for AI coding agents in Visual Studio Code",
  "publisher": "pranit-sh",
  "license": "MIT",
  "author": "pranit-sh",
  "icon": "media/icon.png",
  "pricing": "Free",
  "homepage": "https://github.com/pranit-sh/codicil#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranit-sh/codicil.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/pranit-sh/codicil/issues"
  },
  "qna": "https://github.com/pranit-sh/codicil/issues",
  "sponsor": {
    "url": "https://www.buymeacoffee.com/pranit.sh"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "agents",
    "knowledge",
    "context",
    "mcp",
    "copilot",
    "memory",
    "documentation"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:.codicil/config.yaml"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Codicil reads .codicil/ from the workspace and runs its verification checks against your files, so it needs a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Codicil needs direct file system access to read and write the .codicil/ knowledge layer."
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm --filter @codicil/core build && pnpm run build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node test/smoke.mjs && node test/packaged.mjs",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@codicil/core": "workspace:*",
    "markdown-it": "^15.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^3.9.2"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codicil",
          "title": "Codicil",
          "icon": "media/codicil.svg"
        }
      ]
    },
    "views": {
      "codicil": [
        {
          "id": "codicil.gettingStarted",
          "name": "Getting Started",
          "icon": "media/codicil.svg",
          "when": "!codicil.initialized"
        },
        {
          "id": "codicil.knowledge",
          "name": "Knowledge",
          "icon": "media/codicil.svg",
          "when": "codicil.initialized"
        },
        {
          "id": "codicil.proposals",
          "name": "Proposals",
          "icon": "media/codicil.svg",
          "when": "codicil.initialized"
        },
        {
          "id": "codicil.context",
          "name": "Context",
          "icon": "media/codicil.svg",
          "when": "codicil.initialized"
        },
        {
          "id": "codicil.agentSetup",
          "name": "Guide",
          "icon": "media/codicil.svg",
          "when": "codicil.initialized"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codicil.gettingStarted",
        "contents": "Give your coding agents reliable project knowledge.\n\nUse Codicil to review, organize and serve project knowledge to agents such as Copilot, Cursor and Claude. Initialize the repo, then connect your agent.\n\n[Initialize Codicil](command:codicil.init)\n\n[Open guide](command:codicil.openMcpSetupGuide)",
        "when": "!codicil.initialized"
      },
      {
        "view": "codicil.agentSetup",
        "contents": "Learn the Codicil workflow, available actions, verification check syntax and agent setup.\n\n[Open guide](command:codicil.openMcpSetupGuide)",
        "when": "codicil.initialized"
      },
      {
        "view": "codicil.knowledge",
        "contents": "No knowledge yet.\n\nKnowledge is the reviewed, project-owned information your agents can use. Remember something to add the first item.",
        "when": "codicil.initialized && !codicil.hasKnowledge"
      },
      {
        "view": "codicil.proposals",
        "contents": "Nothing waiting for review.\n\nProposals are knowledge suggested by agents for your review. Nothing enters the knowledge base until you accept it."
      },
      {
        "view": "codicil.context",
        "contents": "No context yet.\n\nContext shows which reviewed knowledge applies to the file you have open. Add knowledge to see what agents would be told here.",
        "when": "codicil.initialized && !codicil.hasKnowledge"
      },
      {
        "view": "codicil.context",
        "contents": "No context applies here.\n\nCodicil checked the open file, but no scoped knowledge matched this part of the project.",
        "when": "codicil.initialized && codicil.hasKnowledge"
      }
    ],
    "commands": [
      {
        "command": "codicil.init",
        "title": "Codicil: Set up the knowledge layer",
        "icon": "$(add)"
      },
      {
        "command": "codicil.configureMcp",
        "title": "Codicil: Configure MCP for Copilot",
        "icon": "$(plug)"
      },
      {
        "command": "codicil.configureCursorMcp",
        "title": "Codicil: Configure MCP for Cursor",
        "icon": "$(plug)"
      },
      {
        "command": "codicil.configureClaudeCodeMcp",
        "title": "Codicil: Configure MCP for Claude Code",
        "icon": "$(plug)"
      },
      {
        "command": "codicil.addAgentInstructions",
        "title": "Codicil: Add agent instructions",
        "icon": "$(notebook)"
      },
      {
        "command": "codicil.openMcpSetupGuide",
        "title": "Codicil: Open Guide",
        "icon": "$(book)"
      },
      {
        "command": "codicil.remember",
        "title": "Codicil: Remember this",
        "icon": "$(lightbulb)"
      },
      {
        "command": "codicil.rememberSelection",
        "title": "Codicil: Remember the selected text"
      },
      {
        "command": "codicil.refresh",
        "title": "Codicil: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "codicil.showItem",
        "title": "Codicil: Show knowledge item"
      },
      {
        "command": "codicil.openFile",
        "title": "Codicil: Open the Markdown file",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codicil.archiveItem",
        "title": "Codicil: Archive",
        "icon": "$(archive)"
      },
      {
        "command": "codicil.restoreItem",
        "title": "Codicil: Restore",
        "icon": "$(history)"
      },
      {
        "command": "codicil.verifyItem",
        "title": "Codicil: Verify against the code",
        "icon": "$(check)"
      },
      {
        "command": "codicil.verifyAll",
        "title": "Codicil: Verify everything",
        "icon": "$(check-all)"
      },
      {
        "command": "codicil.reviewProposal",
        "title": "Codicil: Review proposal"
      },
      {
        "command": "codicil.acceptProposal",
        "title": "Codicil: Accept proposal",
        "icon": "$(check)"
      },
      {
        "command": "codicil.rejectProposal",
        "title": "Codicil: Reject proposal",
        "icon": "$(close)"
      },
      {
        "command": "codicil.showContext",
        "title": "Codicil: What does the agent know here?",
        "icon": "$(eye)"
      },
      {
        "command": "codicil.doctor",
        "title": "Codicil: Check the knowledge layer for problems"
      },
      {
        "command": "codicil.filterByStatus",
        "title": "Codicil: Filter knowledge",
        "icon": "$(filter)"
      },
      {
        "command": "codicil.gettingStarted.focus",
        "title": "Codicil: Focus on Getting Started View"
      },
      {
        "command": "codicil.knowledge.focus",
        "title": "Codicil: Focus on Knowledge View"
      },
      {
        "command": "codicil.proposals.focus",
        "title": "Codicil: Focus on Proposals View"
      },
      {
        "command": "codicil.context.focus",
        "title": "Codicil: Focus on Context View"
      },
      {
        "command": "codicil.agentSetup.focus",
        "title": "Codicil: Focus on Guide View"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codicil.remember",
          "when": "view == codicil.knowledge",
          "group": "navigation@1"
        },
        {
          "command": "codicil.verifyAll",
          "when": "view == codicil.knowledge",
          "group": "navigation@3"
        },
        {
          "command": "codicil.refresh",
          "when": "view == codicil.knowledge",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "codicil.openFile",
          "when": "view == codicil.knowledge && viewItem =~ /^item/",
          "group": "inline@1"
        },
        {
          "command": "codicil.verifyItem",
          "when": "view == codicil.knowledge && viewItem =~ /^item/",
          "group": "1_act@1"
        },
        {
          "command": "codicil.archiveItem",
          "when": "view == codicil.knowledge && viewItem == item",
          "group": "1_act@2"
        },
        {
          "command": "codicil.restoreItem",
          "when": "view == codicil.knowledge && viewItem == item.archived",
          "group": "1_act@2"
        },
        {
          "command": "codicil.acceptProposal",
          "when": "view == codicil.proposals && viewItem == proposal",
          "group": "inline@1"
        },
        {
          "command": "codicil.rejectProposal",
          "when": "view == codicil.proposals && viewItem == proposal",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "codicil.rememberSelection",
          "when": "editorHasSelection",
          "group": "codicil@1"
        },
        {
          "command": "codicil.showContext",
          "group": "codicil@2"
        }
      ],
      "commandPalette": [
        {
          "command": "codicil.configureMcp",
          "when": "false"
        },
        {
          "command": "codicil.configureCursorMcp",
          "when": "false"
        },
        {
          "command": "codicil.configureClaudeCodeMcp",
          "when": "false"
        },
        {
          "command": "codicil.addAgentInstructions",
          "when": "false"
        },
        {
          "command": "codicil.rememberSelection",
          "when": "false"
        },
        {
          "command": "codicil.refresh",
          "when": "false"
        },
        {
          "command": "codicil.showItem",
          "when": "false"
        },
        {
          "command": "codicil.openFile",
          "when": "false"
        },
        {
          "command": "codicil.archiveItem",
          "when": "false"
        },
        {
          "command": "codicil.restoreItem",
          "when": "false"
        },
        {
          "command": "codicil.verifyItem",
          "when": "false"
        },
        {
          "command": "codicil.verifyAll",
          "when": "false"
        },
        {
          "command": "codicil.doctor",
          "when": "false"
        },
        {
          "command": "codicil.reviewProposal",
          "when": "false"
        },
        {
          "command": "codicil.acceptProposal",
          "when": "false"
        },
        {
          "command": "codicil.rejectProposal",
          "when": "false"
        },
        {
          "command": "codicil.filterByStatus",
          "when": "false"
        },
        {
          "command": "codicil.gettingStarted.focus",
          "when": "false"
        },
        {
          "command": "codicil.knowledge.focus",
          "when": "false"
        },
        {
          "command": "codicil.proposals.focus",
          "when": "false"
        },
        {
          "command": "codicil.context.focus",
          "when": "false"
        },
        {
          "command": "codicil.agentSetup.focus",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Codicil",
      "properties": {
        "codicil.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show how many knowledge items apply to the file you are editing."
        },
        "codicil.groupBy": {
          "type": "string",
          "enum": [
            "type",
            "status",
            "scope"
          ],
          "default": "type",
          "description": "How to group the knowledge tree."
        }
      }
    }
  }
}
