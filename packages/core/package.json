{
  "name": "@codicil/core",
  "version": "0.1.0",
  "description": "Schema, store, scope model, resolver, verifier and history for Codicil",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "codicil",
    "knowledge",
    "ai",
    "agent",
    "context",
    "schema",
    "store"
  ],
  "author": "Pranit Deshmukh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranit-sh/codicil.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/pranit-sh/codicil/issues"
  },
  "homepage": "https://github.com/pranit-sh/codicil#readme",
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/pranit.sh"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "picomatch": "^4.0.5",
    "ulid": "^3.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  }
}
