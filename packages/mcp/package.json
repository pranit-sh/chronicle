{
  "name": "codicil-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing a Codicil knowledge layer to AI coding agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "codicil-mcp": "./dist/bin.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "codicil",
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "llm",
    "copilot",
    "cursor",
    "claude",
    "knowledge",
    "context",
    "memory"
  ],
  "author": "Pranit Deshmukh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranit-sh/codicil.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/pranit-sh/codicil/issues"
  },
  "homepage": "https://github.com/pranit-sh/codicil#readme",
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/pranit.sh"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@codicil/core": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
